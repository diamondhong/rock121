rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidRanking(data) {
      return data.keys().hasAll(['name', 'score', 'wins', 'draws', 'losses', 'time', 'createdAt'])
        && data.keys().size() == 7
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 20
        && data.score is number
        && data.score >= 0
        && data.score <= 100
        && data.wins is number
        && data.wins >= 0
        && data.wins <= 10
        && data.draws is number
        && data.draws >= 0
        && data.draws <= 10
        && data.losses is number
        && data.losses >= 0
        && data.losses <= 10
        && data.wins + data.draws + data.losses == 10
        && data.time is number
        && data.time >= 0
        && data.createdAt == request.time;
    }

    match /rockPaperScissorsRankings/{rankingId} {
      // Anyone can read rankings
      allow read: if true;
      // Anyone can post a valid game result
      allow create: if isValidRanking(request.resource.data);
      // Prevent updating or deleting existing records
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
